PORT=5050
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL / Supabase Database Configuration
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=YOUR_SUPABASE_USER
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_SSL=false
DATABASE_URL=postgresql://YOUR_SUPABASE_USER:YOUR_SUPABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET
ADMIN_JWT_SECRET=YOUR_SECURE_ADMIN_JWT_SECRET

# Telegram Alerts
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# UPI Payment Merchant Info
PAYMENT_UPI_ID=YOUR_UPI_ID
PAYMENT_MERCHANT_NAME=YOUR_MERCHANT_NAME

# Loggin.dev WhatsApp Auth Key
LOGGIN_APP_KEY=YOUR_LOGGIN_APP_KEY
